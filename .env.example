# 🛒 Retail Sales Forecasting — Environment Configuration Template
# ------------------------------------------------------------------------------
# 📦 INSTRUCTIONS: 
# 1. Copy this file to '.env' 
# 2. Update placeholders with your actual values.
# 3. Securely manage your .env file and NEVER commit it to GitHub.
# ------------------------------------------------------------------------------

# ── N8N Configuration ──────────────────────────────────────────────────────────
GENERIC_TIMEZONE=Asia/Kolkata
# UI Basic Auth (Credentials used to log into n8n UI at http://localhost:5678)
N8N_BASIC_AUTH_USER=example@email.com
N8N_BASIC_AUTH_PASSWORD=choose_secure_password_here

# ── Google Cloud / Gmail API Credentials ───────────────────────────────────────
# (Obtained from Google Cloud Console → APIs & Services → Credentials)
GOOGLE_CLIENT_ID=your_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_client_secret_here

# ── API / Project Settings ────────────────────────────────────────────────────
PORT=8000
N8N_PORT=5678
TZ=Asia/Kolkata
# ------------------------------------------------------------------------------
# End of Template
